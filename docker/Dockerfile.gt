# Reference detector for building pseudo ground truth. Needs an NVIDIA GPU.
# Plain CUDA runtime + pip TensorRT, no DeepStream.
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends python3.12 python3-pip > /dev/null && \
    rm -rf /var/lib/apt/lists/*

RUN pip3 install --quiet --break-system-packages numpy opencv-python-headless cupy-cuda12x && \
    pip3 install --quiet --break-system-packages --no-deps \
      tensorrt_cu13==10.16.0.72 tensorrt_cu13_bindings==10.16.0.72 tensorrt_cu13_libs==10.16.0.72

WORKDIR /app
